# Скопируйте этот файл в .env и заполните значения.
# .env в git не попадает.

# --- Django -----------------------------------------------------------------
# Сгенерировать: uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Прод-безопасность ------------------------------------------------------
# True включает HTTPS-редирект, secure-cookies и HSTS. На проде за nginx — True,
# локально и в тестах — False (иначе runserver и pytest уводят на https).
SECURE_SSL_REDIRECT=False

# --- База данных ------------------------------------------------------------
# Без этой строки Django работает с локальным SQLite (db.sqlite3).
# Для PostgreSQL 16 из README:
DATABASE_URL=postgres://starburger:starburger@127.0.0.1:5432/starburger

# --- Яндекс.Геокодер --------------------------------------------------------
# Ключ из https://developer.tech.yandex.ru/ (API «Геокодер»).
# Без ключа сайт работает, но расстояния до ресторанов не считаются.
YANDEX_GEOCODER_API_KEY=
# Кэш `Place`: сколько дней доверять удачному ответу и отказу.
GEOCODER_CACHE_TTL_DAYS=30
GEOCODER_NEGATIVE_TTL_DAYS=1

# --- Rollbar -----------------------------------------------------------------
# Необязательно: без токена middleware просто не подключается.
ROLLBAR_TOKEN=
ROLLBAR_ENVIRONMENT=development

# --- Демо-данные -------------------------------------------------------------
# Пароль аккаунта, который создаёт `manage.py seed_demo`.
DEMO_MANAGER_PASSWORD=demo-star-burger
